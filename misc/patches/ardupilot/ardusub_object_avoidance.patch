diff --git a/ArduSub/mode_guided.cpp b/ArduSub/mode_guided.cpp
index bb790e6..ca53d7b 100644
--- a/ArduSub/mode_guided.cpp
+++ b/ArduSub/mode_guided.cpp
@@ -224,8 +224,14 @@ bool ModeGuided::guided_set_destination(const Vector3f& destination_neu_cm, bool
         guided_pos_control_start();
     }
 
-    // set yaw state
-    guided_set_yaw_state(use_yaw, yaw_cd, use_yaw_rate, yaw_rate_cds, relative_yaw);
+    // set yaw state; with no yaw or yaw rate requested, follow WP_YAW_BEHAVIOR
+    // (e.g. face along the path) instead of freezing the current heading
+    if (use_yaw || use_yaw_rate) {
+        guided_set_yaw_state(use_yaw, yaw_cd, use_yaw_rate, yaw_rate_cds, relative_yaw);
+    } else {
+        sub.yaw_rate_only = false;
+        set_auto_yaw_mode(get_default_auto_yaw_mode(false));
+    }
 
     update_time_ms = AP_HAL::millis();
 

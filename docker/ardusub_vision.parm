# Vision navigation overlay, loaded after ardusub_frame_config.parm by the
# ardupilot-sitl-vision compose service. GPS off; horizontal position and
# velocity come from MAVLink ODOMETRY sent by src/vision_nav/vision_bridge.py.
# Depth stays on the baro (ArduSub's pressure sensor), heading on the compass
# (vision_bridge aligns the VO frame to it at startup).
# The ardupilot_gazebo plugin sends no_time_sync=true, which makes SITL
# default AHRS_EKF_TYPE to 10 (simulator ground truth, no EKF - external nav
# would be silently ignored). The model runs lock_step, so EKF3 is safe.
AHRS_EKF_TYPE    3
EK3_ENABLE       1
GPS1_TYPE        0
SIM_GPS1_ENABLE  0
VISO_TYPE        1
VISO_DELAY_MS    30
VISO_QUAL_MIN    1
EK3_SRC1_POSXY   6
EK3_SRC1_VELXY   6
EK3_SRC1_POSZ    1
EK3_SRC1_VELZ    0
EK3_SRC1_YAW     1
# Without GPS, auto-declination only kicks in once vision_bridge sets the EKF
# origin - after the heading has already initialised - so the EKF yaw then
# slowly swings ~4.7 deg and drifts away from the VO frame aligned at
# startup. Pin the declination for the fixed --custom-location instead
# (value is what COMPASS_AUTODEC computes for 63.52N 10.35E).
COMPASS_AUTODEC  0
COMPASS_DEC      0.082045

# --- Object avoidance (needs docker/ardusub_object_avoidance.patch) ---
# Depth camera -> OBSTACLE_DISTANCE (src/vision_nav/obstacle_distance.py) ->
# proximity -> object database -> BendyRuler path planner, which bends
# GUIDED legs around obstacles. Defaults are sized for drones in open air
# (5 m margin, 15 m lookahead) and would block everything in a 25 m pool.
PRX1_TYPE          2
PRX_FILT           1
OA_TYPE            1
# AUV half-width 0.29 m + ~0.2 m position error; gate posts are 0.75 m
# either side of the gate centre, so it still fits through
OA_MARGIN_MAX      0.5
OA_BR_LOOKAHEAD    3
OA_DB_BEAM_WIDTH   1.2
OA_DB_DIST_MAX     8

# Face along the path in GUIDED (needs the patch above: stock ArduSub holds
# the current heading when a position target has no yaw). With OA this is the
# bent path around obstacles, so the forward depth camera looks where the
# AUV is going.
WP_YAW_BEHAVIOR    1
